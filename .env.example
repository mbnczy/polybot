# ── Polymarket CLOB credentials ───────────────────────────────────────────────
# EOA private key (MetaMask export, hex with 0x prefix)
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Funder address — the EOA that holds USDC collateral on Polygon
POLY_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS_HERE

# ── Telegram alerting ──────────────────────────────────────────────────────────
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your personal chat ID or group chat ID (use @userinfobot to find it)
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ── Polygon RPC ────────────────────────────────────────────────────────────────
# Public fallback: https://polygon-rpc.com
# Recommended: Alchemy / QuickNode private endpoint for lower latency
POLYGON_RPC_URL=https://polygon-rpc.com

# ── Arbitrage market — ONE binary market per bot instance ─────────────────────
# YES outcome token ID (CLOB token, not the condition ID).
# Find these from GET https://clob.polymarket.com/markets or the Polymarket UI.
YES_TOKEN_ID=0xYES_TOKEN_ID_HERE

# NO outcome token ID — the complementary leg of the same market.
NO_TOKEN_ID=0xNO_TOKEN_ID_HERE

# Polymarket condition ID for this market (used only for labelling Telegram alerts).
# Optional: a fallback label is derived from the token IDs if this is omitted.
CONDITION_ID=0xCONDITION_ID_HERE

# ── Arbitrage signal parameters ────────────────────────────────────────────────
# Combined ask threshold: P_yes + P_no must be BELOW this value to trigger a trade.
# Default 0.985 leaves 1.5 % margin to absorb CLOB taker fees (≈ 0.5–1.0 %)
# and bid/ask slippage on the dual FOK legs.
ARB_THRESHOLD=0.985

# ── Capital / risk parameters ──────────────────────────────────────────────────
# Starting balance in USDC — used to calibrate the session drawdown guard.
STARTING_BALANCE=500.0

# Hard daily loss limit in USDC (negative).  Bot halts when daily PnL ≤ this.
# Defined in risk/circuit_breaker.py (DAILY_LOSS_LIMIT = -250.0).
# Informational only — edit circuit_breaker.py to change the hard limit.
# DAILY_LOSS_LIMIT=-250.0

# Hard per-trade combined cost cap in USDC (YES cost + NO cost ≤ this).
# Defined in risk/circuit_breaker.py (MAX_ARB_PAIR_USDC = 50.0).
# Informational only — edit circuit_breaker.py to change the hard limit.
# MAX_ARB_PAIR_USDC=50.0

# Maximum concurrent open arb positions (default 5).
MAX_POSITIONS=5

# Session drawdown guard: block new orders when session PnL < -(pct/100) × balance.
MAX_SESSION_DRAWDOWN_PCT=15

# ── Market scanner — priority feed limit ──────────────────────────────────────
# Maximum number of markets admitted per scan cycle (ranked by maker-rebate score).
# 0 = unlimited (admit every discovered market, original behaviour).
MAX_FEEDS=50

# ── Logging ────────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING  (default INFO)
LOG_LEVEL=INFO

# ── Paper trading (set true to simulate orders without real network calls) ─────
PAPER_TRADE_MODE=false
