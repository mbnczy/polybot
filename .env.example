# ── Polymarket CLOB credentials ───────────────────────────────────────────────
# EOA private key (MetaMask export, hex with 0x prefix)
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# Funder address — the EOA that holds USDC collateral on Polygon
POLY_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS_HERE

# ── Telegram alerting ──────────────────────────────────────────────────────────
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your personal chat ID or group chat ID (use @userinfobot to find it)
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ── Polygon RPC ────────────────────────────────────────────────────────────────
# Public fallback: https://polygon-rpc.com
# Recommended: Alchemy / QuickNode private endpoint for lower latency
POLYGON_RPC_URL=https://polygon-rpc.com

# ── Arbitrage market — ONE binary market per bot instance ─────────────────────
# YES outcome token ID (CLOB token, not the condition ID).
# Find these from GET https://clob.polymarket.com/markets or the Polymarket UI.
YES_TOKEN_ID=0xYES_TOKEN_ID_HERE

# NO outcome token ID — the complementary leg of the same market.
NO_TOKEN_ID=0xNO_TOKEN_ID_HERE

# Polymarket condition ID for this market (used only for labelling Telegram alerts).
# Optional: a fallback label is derived from the token IDs if this is omitted.
CONDITION_ID=0xCONDITION_ID_HERE

# ── Arbitrage signal parameters ────────────────────────────────────────────────
# Minimum net edge (after fee/rebate) required to fire a signal, as a fraction.
# 0.005 = 0.50 %.  THIS is the live trigger the bot actually reads.
DESIRED_NET_MARGIN=0.005

# Conservative taker-fee assumption for the taker path (fraction). 0.02 = 2 %.
DEFAULT_TAKER_FEE=0.02

# DEPRECATED — no longer read by the code. The old combined-ask threshold
# (P_yes+P_no < ARB_THRESHOLD) was replaced by DESIRED_NET_MARGIN above.
# Mapping: ARB_THRESHOLD=0.985 ≈ DESIRED_NET_MARGIN=0.015 (1.5 % gross). Kept
# here only as a migration note; setting it has no effect.
# ARB_THRESHOLD=0.985

# ── Signal-quality guards (efficiency-and-reliability) ─────────────────────────
# Skip near-resolved / extreme markets: a signal fires only when BOTH legs' asks
# sit within [EXTREME_PRICE_LO, EXTREME_PRICE_HI]. Filters rebate-inflated edges
# on ~decided, thin books that rarely fill.
EXTREME_PRICE_LO=0.05
EXTREME_PRICE_HI=0.95

# Minimum *real* pre-rebate gap on the maker path: real_edge = 1-(yes_ask+no_ask).
# 0.0 = OFF (legacy: allow rebate-funded entries). Set e.g. 0.002 (20 bps) to
# require a genuine sub-$1 combined cost so the rebate is upside, not the basis.
MIN_REAL_EDGE=0.0

# Reject ticks older than this many seconds (stale quote → adverse selection).
# 0 = disabled.
MAX_TICK_AGE_S=2.0

# ── Telegram arb-detection alerts (throttling) ─────────────────────────────────
# Per-market cooldown between detection alerts (seconds) and a minimum-edge floor
# in basis points below which detections are not alerted (still traded).
ARB_ALERT_COOLDOWN_S=300
ARB_ALERT_MIN_BPS=0

# ── Capital / risk parameters ──────────────────────────────────────────────────
# Starting balance in USDC — used to calibrate the session drawdown guard.
STARTING_BALANCE=500.0

# Hard daily loss limit in USDC (negative).  Bot halts when daily PnL ≤ this.
# Defined in risk/circuit_breaker.py (DAILY_LOSS_LIMIT = -250.0).
# Informational only — edit circuit_breaker.py to change the hard limit.
# DAILY_LOSS_LIMIT=-250.0

# Hard per-trade combined cost cap in USDC (YES cost + NO cost ≤ this).
# Defined in risk/circuit_breaker.py (MAX_ARB_PAIR_USDC = 50.0).
# Informational only — edit circuit_breaker.py to change the hard limit.
# MAX_ARB_PAIR_USDC=50.0

# Maximum concurrent open arb positions (default 5).
MAX_POSITIONS=5

# Session drawdown guard: block new orders when session PnL < -(pct/100) × balance.
MAX_SESSION_DRAWDOWN_PCT=15

# ── Market scanner — feed limits & efficiency ──────────────────────────────────
# GLOBAL cap on concurrently-active WebSocket feeds (ranked by maker-rebate score).
# 0 = unlimited. This is now a hard ceiling on TOTAL feeds, enforced by the
# FeedRegistry — feeds no longer grow without bound across re-scans.
MAX_FEEDS=50

# Drop a feed if it produces no two-sided quote for this many seconds (dead /
# illiquid market). Freed slots are reused for fresher candidates. 0 = never prune.
FEED_PRUNE_IDLE_S=600

# Skip candidate markets whose 24h volume is below this floor (dead books waste a
# feed slot and rarely offer capturable arbs). 0 = no floor.
MIN_VOLUME_24H=0

# Seconds between Gamma API re-scans.
SCAN_INTERVAL=300

# ── NegRisk multi-outcome execution ────────────────────────────────────────────
# "off"     → detect + Telegram alert only (DEFAULT — safe for normal wallets).
#             The live NegRisk path submits an on-chain CTF Exchange V2
#             matchOrders transaction, which REVERTS unless the wallet is a
#             registered exchange operator.
# "onchain" → legacy matchOrders execution (registered operator wallets only).
NEGRISK_EXEC_MODE=off

# ── Execution concurrency / performance ───────────────────────────────────────
# Max concurrent in-flight executions dispatched off the strategy consumer so a
# slow order round-trip never stalls evaluation of other markets (Phase 2).
EXEC_CONCURRENCY=6

# Worker threads for blocking SDK calls (ECDSA signing + order submission).
# Should comfortably exceed 2 × EXEC_CONCURRENCY peak two-leg signings.
CLOB_SIGNER_THREADS=8

# Arbitrage-duration reporting: only report an arb window on Telegram if it
# lasted at least this many seconds (0 = report every close; raise to filter
# sub-second flickers).
ARB_DURATION_MIN_S=0

# ── Logging ────────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING  (default INFO)
LOG_LEVEL=INFO

# ── Paper trading (set true to simulate orders without real network calls) ─────
PAPER_TRADE_MODE=false
